{
  "openapi": "3.1.0",
  "info": {
    "title": "Tri-AL plugin: results",
    "version": "0.1.0"
  },
  "paths": {
    "/api/x/results/trials/{source_id}": {
      "get": {
        "tags": [
          "plugin: results"
        ],
        "summary": "Gettrialresults",
        "description": "A trial's posted results: participant flow, baseline characteristics, outcome\nmeasures with their analyses, adverse events by arm, limitations and agreements.",
        "operationId": "getTrialResults",
        "parameters": [
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Source Id"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The registry, if the id is in several",
              "title": "Source"
            },
            "description": "The registry, if the id is in several"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrialResultsOut"
                }
              }
            }
          },
          "404": {
            "description": "No such trial, or it has no results posted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "409": {
            "description": "The id is in several registries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "503": {
            "description": "There's no data yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
